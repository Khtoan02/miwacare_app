# MiwaCare — mẫu biến môi trường
# Copy file này thành ".env" rồi điền giá trị. KHÔNG đưa file .env lên GitHub, không gửi qua chat/Zalo/email.

# --- Pancake POS (chỉ dùng trên server / Supabase Secrets, KHÔNG đưa vào app) ---
PANCAKE_API_BASE=https://pos.pages.fm/api/v1
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=
# Chuỗi bí mật tự đặt, cấu hình làm header khi bật webhook trên Pancake
PANCAKE_WEBHOOK_SECRET=

# --- Supabase (điền sau khi tạo project) ---
SUPABASE_URL=
# Khoá public, được phép nằm trong app
SUPABASE_ANON_KEY=
# Khoá quản trị — CHỈ dùng trên server, tuyệt đối không đưa vào app
SUPABASE_SERVICE_ROLE_KEY=

# --- Expo ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OTP (SMS brandname / Zalo ZNS) — điền khi chốt nhà cung cấp ---
OTP_PROVIDER=
OTP_API_KEY=

# --- Giám sát ---
SENTRY_DSN=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
